# -------------------------------------------------------------
# Saanvi Sarees - Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# NEVER commit real credentials to version control.
# -------------------------------------------------------------

# --- Server & General Config ---
PORT=8080
SPRING_PROFILES_ACTIVE=dev
APP_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173

# --- Database Configuration (PostgreSQL / Neon / RDS) ---
# For local dev without Postgres, the app falls back seamlessly to embedded H2 if DB is not supplied
DB_HOST=localhost
DB_PORT=5432
DB_NAME=saanvi_sarees_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password
DB_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}

# --- JWT Authentication ---
# Secret must be at least 256 bits (32+ alphanumeric characters)
JWT_SECRET=SaanviSareesSuperSecretKeyForJwtTokenGenerationAndValidation2026!
JWT_EXPIRATION_MS=86400000

# --- Payment Gateway (Razorpay India) ---
# Test keys from https://dashboard.razorpay.com/#/app/keys
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# --- Email Notifications (SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=notifications@saanvisarees.com
MAIL_PASSWORD=your_app_password
MAIL_FROM_ADDRESS=orders@saanvisarees.com
MAIL_ENABLED=false

# --- Cloudinary Image Storage (Optional - fallback to CDN images) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Initial Admin Setup ---
# Automatically seeded on first startup if not already existing
INITIAL_ADMIN_EMAIL=admin@saanvisarees.com
INITIAL_ADMIN_PASSWORD=Admin@Saanvi2026!
INITIAL_ADMIN_NAME=Saanvi Master Admin
